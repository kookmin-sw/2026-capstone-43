<?xml version="1.0"?>
<launch>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/color/camera_info"/>
  <arg name="odom_topic" default="/robot/odom"/>
  <arg name="pose_source" default="odom"/>
  <arg name="target_frame" default="odom"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="camera_frame" default=""/>
  <arg name="output_dir" default="$(env HOME)/rgb_pose_dataset"/>
  <arg name="min_interval" default="0.333333"/>
  <arg name="min_translation" default="0.0"/>
  <arg name="min_rotation" default="0.0"/>
  <arg name="image_format" default="png"/>
  <arg name="use_latest_tf" default="true"/>

  <node pkg="uni_navigation" type="collect_rgb_pose.py" name="collect_rgb_pose" output="screen">
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="odom_topic" value="$(arg odom_topic)"/>
    <param name="pose_source" value="$(arg pose_source)"/>
    <param name="target_frame" value="$(arg target_frame)"/>
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="camera_frame" value="$(arg camera_frame)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="min_interval" value="$(arg min_interval)"/>
    <param name="min_translation" value="$(arg min_translation)"/>
    <param name="min_rotation" value="$(arg min_rotation)"/>
    <param name="image_format" value="$(arg image_format)"/>
    <param name="use_latest_tf" value="$(arg use_latest_tf)"/>
  </node>
</launch>
